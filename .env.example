# ---------------------------------------------------------------------------
# Vibely POS — Environment Variables
# Copy this file to .env and fill in the values.
# ---------------------------------------------------------------------------

# --- Direct connection (use for Flyway migrations and DDL) -----------------
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>

# --- PgBouncer pooler (use for HikariCP / application runtime) -------------
# Transaction-mode pooling — do NOT use for Flyway or SET session variables
DB_POOLER_HOST=
DB_POOLER_PORT=6543
DB_POOLER_USER=postgres.<project-ref>
DATABASE_POOLER_URL=jdbc:postgresql://<DB_POOLER_HOST>:6543/<DB_NAME>

# --- Auth ------------------------------------------------------------------
# Options: debug | production
AUTH_MODE=debug
